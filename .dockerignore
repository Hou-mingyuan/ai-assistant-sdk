**

# Root aggregator POM is required by the multi-module Maven build inside Docker.
!pom.xml

!ai-assistant-server/
!ai-assistant-server/pom.xml
!ai-assistant-server/src/
!ai-assistant-server/src/**

!ai-assistant-client/
!ai-assistant-client/pom.xml
!ai-assistant-client/src/
!ai-assistant-client/src/**

!ai-assistant-service/
!ai-assistant-service/pom.xml
!ai-assistant-service/src/
!ai-assistant-service/src/**

!ai-assistant-observability-support/
!ai-assistant-observability-support/pom.xml
!ai-assistant-observability-support/src/
!ai-assistant-observability-support/src/**

# The root reactor lists the Starter demo module, so Maven must be able to
# read its POM even though the service image does not compile the demo sources.
!ai-assistant-demo/
!ai-assistant-demo/pom.xml
