{
  "name": "@ai-assistant/vue",
  "version": "1.0.1",
  "type": "module",
  "description": "Embeddable AI assistant widget for Vue 3 - translation, summarization, chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hou-mingyuan/ai-assistant-sdk.git",
    "directory": "ai-assistant-ui"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "dist/ai-assistant.umd.cjs",
  "module": "dist/ai-assistant.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ai-assistant.mjs",
      "require": "./dist/ai-assistant.umd.cjs"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.umd.cjs"
    },
    "./admin": {
      "types": "./dist/entries/admin.d.ts",
      "import": "./dist/admin.mjs",
      "require": "./dist/admin.umd.cjs"
    },
    "./form-fill": {
      "types": "./dist/entries/form-fill.d.ts",
      "import": "./dist/form-fill.mjs",
      "require": "./dist/form-fill.umd.cjs"
    },
    "./mcp": {
      "types": "./dist/entries/mcp.d.ts",
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.umd.cjs"
    },
    "./screenshot": {
      "types": "./dist/entries/screenshot.d.ts",
      "import": "./dist/screenshot.mjs",
      "require": "./dist/screenshot.umd.cjs"
    },
    "./plugin": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.umd.cjs"
    },
    "./wc": {
      "import": "./dist/ai-assistant-wc.mjs",
      "require": "./dist/ai-assistant-wc.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:publish",
    "build:lib": "vite build",
    "build:publish": "npm run build:lib && cross-env BUILD_TARGET=wc PRESERVE_DIST=true vite build && npm run build:types && npm run check:exports",
    "build:wc": "cross-env BUILD_TARGET=wc vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "check:exports": "node ../scripts/check-package-exports.mjs",
    "smoke:package": "node ../scripts/smoke-package-install.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\""
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "mermaid": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.4.10",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "marked": "^12.0.0",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^3.1.0",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.15.0",
    "prettier": "^3.8.4",
    "terser": "^5.48.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.38",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "vue3",
    "translate",
    "summarize",
    "widget"
  ],
  "license": "MIT"
}
