<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.aiassistant</groupId>
    <artifactId>ai-assistant-service</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <name>AI Assistant Service</name>
    <description>Standalone Docker-friendly AI Assistant service built on the starter SDK</description>

    <properties>
        <java.version>21</java.version>
        <tomcat.version>10.1.57</tomcat.version>
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <log4j2.version>2.25.5</log4j2.version>
        <netty.version>4.1.136.Final</netty.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.aiassistant</groupId>
            <artifactId>ai-assistant-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiassistant</groupId>
            <artifactId>ai-assistant-observability-support</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Builds a Redis-capable standalone image so multi-replica deployments get distributed
            rate-limit / session / conversation-memory / token-quota out of the box. The dependency
            is OPTIONAL in the starter and intentionally excluded from the default image footprint;
            activate it explicitly with the Maven profile:

                mvn -Predis package

            The Docker image build wires it through the MAVEN_ARGS build argument
            (MAVEN_ARGS=-Predis). The Helm chart helm-test hook asserts that a redis.enabled
            deployment is actually running distributed storage, so this profile makes that guard
            pass in CI.
        -->
        <profile>
            <id>redis</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-redis</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
