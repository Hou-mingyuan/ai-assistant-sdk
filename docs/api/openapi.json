{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Assistant API",
    "version": "1.0.1",
    "description": "Static OpenAPI snapshot used to generate frontend wire types."
  },
  "servers": [
    {
      "url": "/ai-assistant"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LLM response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stream": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compatibility SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/sse": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "responses": {
          "200": {
            "description": "Available model list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runtime/config": {
      "get": {
        "responses": {
          "200": {
            "description": "Runtime configuration summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModelConfigResult"
                }
              }
            }
          }
        }
      }
    },
    "/admin/runtime/model-config": {
      "get": {
        "responses": {
          "200": {
            "description": "Admin runtime model configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModelConfigResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeModelConfigPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated runtime model configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModelConfigResult"
                }
              }
            }
          }
        }
      }
    },
    "/templates": {
      "get": {
        "responses": {
          "200": {
            "description": "Prompt template registry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PromptTemplateEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/url-preview": {
      "get": {
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched page preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlPreviewResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["translate", "summarize", "chat"]
          },
          "text": {
            "type": "string"
          },
          "targetLang": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageItem"
            }
          },
          "systemPrompt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "imageData": {
            "type": "string"
          },
          "imageDataList": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pageContext": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        }
      },
      "MessageItem": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant", "system"]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/RuntimeMeta"
          }
        }
      },
      "RuntimeMeta": {
        "type": "object",
        "properties": {
          "requestedModel": {
            "type": "string"
          },
          "effectiveModel": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "fallback": {
            "type": "boolean"
          },
          "visionInputCount": {
            "type": "integer"
          },
          "visionRoute": {
            "type": "string"
          }
        }
      },
      "ModelsListResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultModel": {
            "type": "string"
          },
          "modelDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelDetail"
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ModelDetail": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "RuntimeModelConfigResult": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "provider": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "allowedModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apiKeyConfigured": {
            "type": "boolean"
          },
          "minimaxVlmBaseUrl": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "RuntimeModelConfigPayload": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "allowedModelsText": {
            "type": "string"
          },
          "minimaxVlmBaseUrl": {
            "type": "string"
          }
        }
      },
      "PromptTemplateEntry": {
        "type": "object",
        "required": ["name", "template"],
        "properties": {
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "hasFewShot": {
            "type": "boolean"
          }
        }
      },
      "AdminOverview": {
        "type": "object",
        "required": ["usage", "tokenUsage", "registeredTools", "promptTemplates", "activeABTests"],
        "properties": {
          "usage": {
            "type": "object",
            "additionalProperties": true
          },
          "tokenUsage": {
            "type": "object",
            "additionalProperties": true
          },
          "registeredTools": {
            "type": "integer"
          },
          "promptTemplates": {
            "type": "integer"
          },
          "activeABTests": {
            "type": "integer"
          }
        }
      },
      "AdminPromptEntry": {
        "type": "object",
        "required": ["name", "template"],
        "properties": {
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        }
      },
      "AdminToolEntry": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "AdminRagStats": {
        "type": "object",
        "required": ["namespace", "documentCount"],
        "properties": {
          "namespace": {
            "type": "string"
          },
          "documentCount": {
            "type": "integer"
          }
        }
      },
      "AdminRagIngestResult": {
        "type": "object",
        "required": ["success", "namespace", "chunks"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "namespace": {
            "type": "string"
          },
          "chunks": {
            "type": "integer"
          }
        }
      },
      "AdminAbTestConfig": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "modelA": {
            "type": "string"
          },
          "modelB": {
            "type": "string"
          },
          "percentA": {
            "type": "number"
          }
        }
      },
      "AdminFallbackChain": {
        "type": "object",
        "required": ["chain"],
        "properties": {
          "chain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AdminPluginsResult": {
        "type": "object",
        "required": ["plugins", "enabled"],
        "properties": {
          "plugins": {
            "type": "object",
            "additionalProperties": true
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "AdminSystemInfo": {
        "type": "object",
        "properties": {
          "javaVersion": {
            "type": "string"
          },
          "osName": {
            "type": "string"
          },
          "availableProcessors": {
            "type": "integer"
          },
          "maxMemoryMb": {
            "type": "integer"
          },
          "freeMemoryMb": {
            "type": "integer"
          },
          "totalMemoryMb": {
            "type": "integer"
          },
          "registeredTools": {
            "type": "integer"
          },
          "promptTemplates": {
            "type": "integer"
          },
          "fallbackChain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "loadedPlugins": {
            "type": "integer"
          }
        }
      },
      "UrlPreviewResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
