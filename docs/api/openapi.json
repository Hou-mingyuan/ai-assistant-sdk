{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Assistant API",
    "version": "1.0.1",
    "description": "Static OpenAPI snapshot used to generate frontend wire types."
  },
  "servers": [
    {
      "url": "/ai-assistant"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LLM response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stream": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compatibility SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/sse": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "responses": {
          "200": {
            "description": "Available model list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runtime/config": {
      "get": {
        "responses": {
          "200": {
            "description": "Runtime configuration summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeModelConfigResult"
                }
              }
            }
          }
        }
      }
    },
    "/url-preview": {
      "get": {
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fetched page preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrlPreviewResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "parameters": [
          {
            "name": "deep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service health summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "responses": {
          "200": {
            "description": "Usage statistics snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageStatsSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "responses": {
          "200": {
            "description": "User session list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionData"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionData"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionData"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionData"
                }
              }
            }
          },
          "404": {
            "description": "Session not found"
          }
        }
      },
      "put": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionData"
                }
              }
            }
          },
          "404": {
            "description": "Session not found"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted session"
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/file/summarize": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File summary response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/file/translate": {
      "post": {
        "parameters": [
          {
            "name": "targetLang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "zh"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File translation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "translate",
              "summarize",
              "chat"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300000
          },
          "targetLang": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8}){0,3}$"
          },
          "history": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/MessageItem"
            }
          },
          "systemPrompt": {
            "type": "string",
            "maxLength": 16000
          },
          "model": {
            "type": "string",
            "maxLength": 128
          },
          "imageData": {
            "type": "string",
            "maxLength": 10000000
          },
          "imageDataList": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 10000000
            }
          },
          "pageContext": {
            "type": "string",
            "maxLength": 20000
          },
          "sessionId": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:/-]{0,128}$"
          },
          "webSearch": {
            "type": "boolean"
          }
        }
      },
      "MessageItem": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/RuntimeMeta"
          }
        }
      },
      "RuntimeMeta": {
        "type": "object",
        "properties": {
          "requestedModel": {
            "type": "string"
          },
          "effectiveModel": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "fallback": {
            "type": "boolean"
          },
          "visionInputCount": {
            "type": "integer"
          },
          "visionRoute": {
            "type": "string"
          },
          "webSearchEnabled": {
            "type": "boolean"
          },
          "webSearchProvider": {
            "type": "string"
          },
          "webSearchFallback": {
            "type": "boolean"
          },
          "webSearchResultCount": {
            "type": "integer"
          },
          "webSearchSourceUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ModelsListResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultModel": {
            "type": "string"
          },
          "modelDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelDetail"
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ModelDetail": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "RuntimeModelConfigResult": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "provider": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "allowedModels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apiKeyConfigured": {
            "type": "boolean"
          },
          "minimaxVlmBaseUrl": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "success",
          "status",
          "provider",
          "model"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "llmReachable": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      },
      "UsageStatsSnapshot": {
        "type": "object",
        "required": [
          "totalCalls",
          "totalErrors",
          "callsByAction",
          "callsByDate"
        ],
        "properties": {
          "totalCalls": {
            "type": "integer"
          },
          "totalErrors": {
            "type": "integer"
          },
          "callsByAction": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "callsByDate": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "SessionData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionMessageItem"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionMessageItem": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "feedback": {
            "type": "string"
          }
        }
      },
      "FileUploadRequest": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "UrlPreviewResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "imageUrl": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
